# Development Dockerfile for OHIF Viewer with hot reload
# This builds a development container that watches for file changes
# Source code is volume-mounted, dependencies installed at runtime

FROM node:20.18.1-slim

# Install system dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    python3 \
    git \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /usr/src/app

# Add node_modules/.bin to PATH
ENV PATH=/usr/src/app/node_modules/.bin:$PATH

# Expose development server port
EXPOSE 3000

# Development server will be started via docker-compose command
CMD ["yarn", "dev"]
